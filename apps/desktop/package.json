{
  "name": "renulus-desktop",
  "productName": "Renulus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renulus Windows learning application",
  "license": "MIT",
  "author": "Renulus contributors",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": "^22.22.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "dev:electron": "node scripts/dev-electron.mjs",
    "start": "electron .",
    "pack:win": "npm run build && electron-builder --config electron-builder.config.cjs --win --dir --publish never"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "27.0.0-alpha.6",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.28.1": true,
    "electron-winstaller": false
  }
}
